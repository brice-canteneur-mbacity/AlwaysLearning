@page "/"
@inject DailyService Daily

<PageTitle>AlwaysLearning — le thème du jour</PageTitle>

<section class="day-intro">
    <p class="day-date">@_dateLabel</p>
    <h1 class="day-heading">Le thème du jour</h1>
</section>

@if (_loading)
{
    <div class="state">
        <div class="spinner"></div>
        <p>Tirage d'un thème au hasard…</p>
    </div>
}
else if (_article is null)
{
    <div class="state state-error">
        <p>😕 Impossible de récupérer un thème.</p>
        <p class="muted">Vérifie ta connexion internet puis réessaie.</p>
        <button class="btn" @onclick="LoadAsync">Réessayer</button>
    </div>
}
else
{
    <ThemeReader Article="_article" @key="_article.Url ?? _article.Title" />

    <button class="btn btn-outline" @onclick="RerollAsync" disabled="@_rerolling">
        @(_rerolling ? "Tirage…" : "🎲 Un autre thème au hasard")
    </button>
}

@code {
    private Article? _article;
    private bool _loading = true;
    private bool _rerolling;

    private readonly DateOnly _today = DailyService.Today;
    private string _dateLabel = "";

    private static readonly string[] Days =
        { "dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi" };
    private static readonly string[] Months =
        { "", "janvier", "février", "mars", "avril", "mai", "juin",
          "juillet", "août", "septembre", "octobre", "novembre", "décembre" };

    protected override async Task OnInitializedAsync()
    {
        var dt = _today.ToDateTime(TimeOnly.MinValue);
        _dateLabel = $"{Days[(int)dt.DayOfWeek]} {_today.Day} {Months[_today.Month]} {_today.Year}";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _article = await Daily.GetThemeAsync(_today);
        }
        catch
        {
            _article = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RerollAsync()
    {
        _rerolling = true;
        StateHasChanged();
        try
        {
            var next = await Daily.RerollThemeAsync(_today);
            if (next is not null)
                _article = next;
        }
        catch
        {
            // On garde le thème courant en cas d'échec.
        }
        finally
        {
            _rerolling = false;
        }
    }
}
