@using System.Text.RegularExpressions

<article class="theme">
    @if (!string.IsNullOrEmpty(Article.ImageUrl))
    {
        <img class="theme-img" src="@Article.ImageUrl" alt="@Article.Title" loading="lazy" />
    }
    <div class="theme-body">
        <h2 class="theme-title">@Article.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Article.Description))
        {
            <p class="card-subtitle">@CapitalizeFirst(Article.Description!)</p>
        }

        <ArticleActions Title="@Article.Title" Description="@Article.Description"
                        Extract="@_teaser" Url="@Article.Url" ImageUrl="@Article.ImageUrl" />

        <div class="reader">
            @foreach (var block in Blocks(_levels[_expanded].Text))
            {
                @if (block.IsHeading)
                {
                    <h3 class="reader-h">@block.Text</h3>
                }
                else
                {
                    <p class="reader-p">@block.Text</p>
                }
            }
        </div>

        <div class="reader-controls">
            @if (_expanded < _levels.Count - 1)
            {
                var next = _levels[_expanded + 1];
                <button class="btn btn-outline" @onclick="Expand">
                    @ExpandLabel(_expanded + 1) · ~@next.Minutes min ▾
                </button>
            }
            else if (_levels.Count > 1)
            {
                <p class="reader-end">Tu as lu l'article complet 🎉</p>
            }

            @if (_expanded > 0)
            {
                <button class="link-btn" @onclick="Collapse">Replier ▴</button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Article Article { get; set; } = default!;

    private IReadOnlyList<ReadingLevel> _levels = Array.Empty<ReadingLevel>();
    private int _expanded;
    private string _teaser = "";

    private static readonly Regex HeadingRegex = new(@"^=+\s*(.+?)\s*=+$", RegexOptions.Compiled);

    protected override void OnParametersSet()
    {
        _levels = ReadingLevels.Build(Article.FullText);
        if (_expanded > _levels.Count - 1)
            _expanded = _levels.Count - 1;
        _teaser = BuildTeaser(Article.FullText);
    }

    private void Expand() => _expanded = Math.Min(_expanded + 1, _levels.Count - 1);
    private void Collapse() => _expanded = 0;

    // Libellé du bouton de dépliage selon le niveau cible.
    private string ExpandLabel(int target) => target switch
    {
        1 => "Déplier la version détaillée",
        _ => "Déplier la version complète",
    };

    private static string BuildTeaser(string text)
    {
        var firstParagraph = Regex.Split(text.Trim(), @"\n{2,}").FirstOrDefault(p => p.Trim().Length > 0)?.Trim() ?? "";
        return firstParagraph.Length <= 220 ? firstParagraph : firstParagraph[..220].TrimEnd() + "…";
    }

    private record Block(string Text, bool IsHeading);

    private static IEnumerable<Block> Blocks(string text)
    {
        foreach (var raw in Regex.Split(text, @"\n{2,}"))
        {
            var p = raw.Trim();
            if (p.Length == 0)
                continue;
            var m = HeadingRegex.Match(p);
            yield return m.Success ? new Block(m.Groups[1].Value, true) : new Block(p, false);
        }
    }

    private static string CapitalizeFirst(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];
}
